FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY evaluation/baseline_metrics.json evaluation/corpus_checksums.csv ./evaluation/
RUN pip install --no-cache-dir ".[mcp,experiments]"

EXPOSE 8000
CMD ["uvicorn", "maintenance_intelligence.api:app", "--host", "0.0.0.0", "--port", "8000"]
