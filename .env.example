DATABASE_URL=postgresql://maintenance:maintenance@localhost:5432/maintenance
API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintenance_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE=data/models
CHUNKS_PATH=data/processed/chunks.jsonl
MANUALS_PATH=data/manuals
CORS_ORIGINS=http://localhost:3000
ADJACENT_CHUNK_RADIUS=1
ANSWER_EVIDENCE_LIMIT=10

# --- LLM provider (optional; "none" keeps the API fully extractive) ---
LLM_PROVIDER=none
# Cheapest current model for synthesis/routing, a mid-tier one as judge (verify IDs with GET /v1/models)
LLM_MODEL=gpt-5.6-luna
LLM_JUDGE_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# --- Observability ---
# none | console | otlp (Phoenix / any collector) | azure (Application Insights)
TRACING_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
APPLICATIONINSIGHTS_CONNECTION_STRING=
MLFLOW_TRACKING_URI=
