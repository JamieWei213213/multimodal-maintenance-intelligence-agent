{"chunk_id": "acs580-01-p40-c0", "document_id": "92a6cd7d94b2", "source_filename": "abb_acs580_01_hardware_3AXD50000044794_revG.pdf", "source_sha256": "92a6cd7d94b22ebb6f57e5c8525c6f033098d6356342b35f48aa89da3a3a9798", "pdf_page": 40, "printed_page": "38", "chunk_index": 0, "kind": "paragraph", "section_path": ["Mechanical installation"], "text": "Mounting the drive: leave the specified free space above and below the unit for cooling air. Install the drive upright on a non-flammable surface.", "block_ids": ["b40-0"], "bboxes": [[56.0, 72.0, 540.0, 100.0]], "extraction_method": "text", "contains_safety_warning": false}
