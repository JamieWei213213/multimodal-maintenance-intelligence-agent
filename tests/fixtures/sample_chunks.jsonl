{"chunk_id": "acs580-01-p9-c0", "document_id": "23fa1da109a2", "source_filename": "abb_acs580_01_quickstart_3AXD50001317799_revB.pdf", "source_sha256": "23fa1da109a20d6f46344e6b1c73a93168d37077c7bde6507cad4c7cc5be8479", "pdf_page": 9, "printed_page": "7", "chunk_index": 0, "kind": "paragraph", "section_path": ["Safety instructions"], "text": "WARNING! Obey the safety instructions. Only qualified electricians may perform the electrical installation. Disconnect the drive from mains before working on it.", "block_ids": ["b9-0"], "bboxes": [[56.0, 72.0, 540.0, 100.0]], "extraction_method": "text", "contains_safety_warning": true}
{"chunk_id": "acs580-01-p200-c0", "document_id": "92a6cd7d94b2", "source_filename": "abb_acs580_01_hardware_3AXD50000044794_revG.pdf", "source_sha256": "92a6cd7d94b22ebb6f57e5c8525c6f033098d6356342b35f48aa89da3a3a9798", "pdf_page": 200, "printed_page": "198", "chunk_index": 0, "kind": "paragraph", "section_path": ["Electrical installation"], "text": "IP55 enclosure variants require the cable entry plate to be sealed after installation to keep the ingress protection rating.", "block_ids": ["b200-0"], "bboxes": [[56.0, 72.0, 540.0, 100.0]], "extraction_method": "text", "contains_safety_warning": false}
